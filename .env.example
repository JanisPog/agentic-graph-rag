# ─────────────────────────────────────────────────────────────────────────────
# Example environment file. Copy to `.env` and fill in your own values:
#     cp .env.example .env
#
# Only the settings that are deployment- or credential-specific are listed
# here. Every other knob (retrieval depth, temperatures, fusion weights,
# ablation switches, ...) has a sensible default in `config.py` and only needs
# an entry here if you want to override it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neo4j ────────────────────────────────────────────────────────────────────
# The knowledge graph the retrievers read from. A local Neo4j 5.26 instance
# started via `docker-compose.yml` matches these defaults.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ── Backend selection ────────────────────────────────────────────────────────
# Which provider serves each model role.
#   EMBED_BACKEND    : ollama | litellm | gemini | vllm
#   CHAT_BACKEND     : litellm | ollama | gemini | vllm
#   RERANKER_BACKEND : local | vllm
EMBED_BACKEND=ollama
CHAT_BACKEND=litellm
RERANKER_BACKEND=local

# ── LiteLLM gateway (default chat backend) ───────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=https://your-litellm-host.example.com
# Model names as your LiteLLM gateway exposes them (often "<provider>/<model>").
LITELLM_CHAT_MODEL=qwen3.5-35b-a3b
LITELLM_EMBED_MODEL=qwen3-embedding-8b
LITELLM_EMBED_DIM=4096

# Optional neutral judge model used by the paper metrics, to avoid the
# generator grading its own output. Falls back to LITELLM_CHAT_MODEL if empty.
JUDGE_MODEL=

# ── vLLM (self-hosted inference) ─────────────────────────────────────────────
VLLM_API_KEY=
VLLM_CHAT_BASE_URL=http://127.0.0.1:8000/v1
VLLM_CHAT_MODEL=
VLLM_EMBED_BASE_URL=http://127.0.0.1:8001/v1
VLLM_EMBED_MODEL=
VLLM_EMBED_DIM=4096
VLLM_RERANKER_BASE_URL=http://127.0.0.1:8002/v1
VLLM_RERANKER_MODEL=

# ── Ollama (local models) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ── Gemini (optional alternative backend) ────────────────────────────────────
GEMINI_API_KEY=

# ── Web search (optional; WEB_SEARCH_ENABLED=false disables the node) ────────
# WEB_SEARCH_PROVIDER selects which of the keys below is used.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
PARALLEL_API_KEY=

# ── Paperless-ngx (optional; only for the DMS ingestion pipeline) ───────────
PAPERLESS_BASE_URL=
PAPERLESS_TOKEN=

# ── Ticket MCP server (optional; used by the A2A ingest endpoint) ───────────
TICKET_MCP_URL=
TICKET_MCP_TOKEN=
